class ENVClass
  include Enumerable[[String, String]]

  def self.new: () -> ENVClass
  def []: (String key) -> (String | nil)
  def []=: (String key, String value) -> String
  def delete: (String key) ?{ (String key) -> void } -> (String | nil)
  def each: () { (String key, String value) -> void } -> ENVClass
  alias each_pair each
  def each_key: () { (String key) -> void } -> ENVClass
  def each_value: () { (String value) -> void } -> ENVClass
  def to_h: () ?{ (String key, String value) -> [untyped, untyped] } -> Hash[untyped, untyped]
  def to_hash: () -> Hash[String, String]
  def keys: () -> Array[String]
  def values: () -> Array[String]
  def key?: (String key) -> bool
  alias has_key? key?
  alias include? key?
  alias member? key?
  def value?: (String value) -> bool
  alias has_value? value?
  def key: (String value) -> (String | nil)
  def size: () -> Integer
  alias length size
  def empty?: () -> bool
  def fetch: (String key, *untyped default) ?{ (String key) -> untyped } -> untyped
  def values_at: (*String keys) -> Array[String | nil]
  def slice: (*String keys) -> Hash[String, String]
  def assoc: (String key) -> ([String, String] | nil)
  def update: (*Hash[String, String] hashes) ?{ (String key, String old_value, String new_value) -> String } -> ENVClass
  alias merge! update
  def clear: () -> ENVClass
  def select: () { (String key, String value) -> boolish } -> Hash[String, String]
  alias filter select
  def reject: () { (String key, String value) -> boolish } -> Hash[String, String]
  def inspect: () -> String
  def to_s: () -> String
  private def _hash: () -> Hash[String, String]
end

ENV: ENVClass
ENV_DEFAULT_WIFI_CONFIG_PATH: String
ENV_DEFAULT_HOME: String
