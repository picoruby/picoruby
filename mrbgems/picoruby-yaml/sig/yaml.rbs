module YAML
  INDICATORS: String
  HEX_DIGITS: String

  # The loaded document is a Hash, an Array or a scalar depending on the
  # source, so the return type cannot be narrowed here.
  def self.load: (String) -> untyped
  def self.load_file: (String) -> untyped
  def self.dump: (Object) -> String

  private def self.parse: (String) -> untyped
  private def self.parse_value: (String, ?Hash[String, untyped]?) -> untyped
  private def self.anchor_only: (String?) -> String?
  private def self.replace_anchor: (Hash[String, untyped], untyped, untyped) -> void
  private def self.assign: (Hash[untyped, untyped], untyped, untyped) -> void
  private def self.quoted?: (String) -> bool
  private def self.quote_end: (String) -> Integer?
  private def self.mapping_item?: (String) -> bool
  private def self.plain?: (String) -> bool
  private def self.plain_key?: (String) -> bool
  private def self.quote: (String) -> String
  private def self.strip_comment: (String) -> String
  private def self.parse_double_quoted: (String) -> String?
  private def self.parse_single_quoted: (String) -> String?
  private def self.parse_flow: (String, Integer, Hash[String, untyped]?) -> (Array[untyped] | Hash[untyped, untyped] | nil)
  private def self.utf8_char: (Integer) -> String
  private def self.serialize: (Object, ?Integer) -> String
  private def self.count_leading_spaces: (String) -> Integer
  private def self.split_key_value: (String) -> [String, (String|nil)]
  private def self.parse_list_item: (String) -> [nil, (String|nil)]
  private def self.parse_list_items: (String) -> Array[Object]
  private def self.is_integer?: (String) -> bool
  private def self.is_float?: (String) -> bool
  private def self.is_boolean?: (String) -> bool
  private def self.is_null?: (String) -> bool
end
