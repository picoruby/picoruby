module JSON
  # @sidebar error
  class JSONError < StandardError
  end
  # @sidebar error
  class ParserError < JSONError
  end
  # @sidebar error
  class GeneratorError < JSONError
  end
  # @sidebar error
  class NestingError < ParserError
  end
  UnparserError: singleton(GeneratorError)
  # @sidebar error
  class DiggerError < JSONError
  end

  module Common
    private def expect: (Integer) -> void
    private def skip_whitespace: () -> void
    private def parse_true: () -> true
    private def parse_false: () -> false
    private def parse_null: () -> nil
    private def expect_sequence: (String) -> void
  end

  PRETTY_STATE_PROTOTYPE: Hash[Symbol, String]

  class State
    attr_accessor indent: String
    attr_accessor space: String
    attr_accessor space_before: String
    attr_accessor object_nl: String
    attr_accessor array_nl: String
    attr_accessor allow_nan: bool
    attr_accessor max_nesting: Integer
    attr_accessor ascii_only: bool
    attr_accessor depth: Integer
    attr_accessor script_safe: bool
    attr_accessor strict: bool

    def self.from_state: (untyped opts) -> State
    def initialize: (?Hash[untyped, untyped]? opts) -> void
    def configure: (Hash[untyped, untyped] opts) -> self
    alias merge configure
    def allow_nan?: () -> bool
    def ascii_only?: () -> bool
    def script_safe?: () -> bool
    def strict?: () -> bool
    def check_circular?: () -> bool
    def []: (Symbol | String name) -> untyped
    def []=: (Symbol | String name, untyped value) -> untyped
    def to_h: () -> Hash[Symbol, untyped]
    alias to_hash to_h
    def generate: (untyped obj) -> String
  end

  class Fragment
    attr_reader json: String
    def initialize: (String json) -> void
    def to_json: (*untyped) -> String
    def ==: (untyped other) -> bool
  end

  def self.parse: (String json, ?untyped opts) -> untyped
  def self.parse!: (String json, ?untyped opts) -> untyped
  def self.load: (untyped source, ?untyped proc, ?untyped opts) -> untyped
  def self.[]: (untyped object, ?untyped opts) -> untyped
  def self.generate: (untyped obj, ?untyped opts) -> String
  def self.unparse: (untyped obj, ?untyped opts) -> String
  def self.fast_generate: (untyped obj, ?untyped opts) -> String
  def self.pretty_generate: (untyped obj, ?untyped opts) -> String
  def self.pretty_unparse: (untyped obj, ?untyped opts) -> String
  def self.dump: (untyped obj, ?untyped io, ?untyped limit) -> untyped
  def self.state: () -> singleton(State)
  def self.parser: () -> singleton(Parser)
  def self.generator: () -> singleton(Generator)

  class Digger
    type dig_key_t = (String | Integer)
    type stack_t = (:array | :object)

    include JSON::Common

    @json: String
    @index: Integer
    @start_index: Integer
    @stack: Array[stack_t]

    def initialize: (String) -> void
    private def reset: () -> void
    def dig: (*dig_key_t) -> self
    def parse: () -> untyped
    private def dig_string: (bool) -> String?
    private def dig_number: () -> void
    private def dig_object: (String | nil) -> void
    private def dig_value: () -> void
    private def dig_array: (Integer | nil) -> void
    private def push_stack: (stack_t) -> void
    private def pop_stack: () -> void
  end

  class Generator
    include JSON::Common

    HEX_CHARS: String

    @obj: untyped
    @state: State?
    @depth: Integer

    def initialize: (untyped, ?State? state) -> void
    def generate: (?untyped) -> String
    private def generate_object: (Hash[String, untyped]) -> String
    private def generate_array: (Array[untyped]) -> String
    private def generate_string: (String) -> String
    private def generate_number: (Integer|Float) -> String
    private def generate_float: (Float) -> String
    private def check_nesting: () -> void
  end

  class Parser
    include JSON::Common

    @json: String
    @index: Integer
    @symbolize_names: bool

    def initialize: (String, ?bool symbolize_names) -> void
    def parse: () -> untyped
    private def parse_object: () -> Hash[String | Symbol, untyped]
    private def parse_array: () -> Array[untyped]
    private def parse_string: () -> String
    private def parse_number: () -> (Integer | Float)
    private def parse_escape: (String, Integer) -> Integer
    private def parse_hex4: (Integer) -> Integer
    private def utf8_encode: (Integer) -> String
    private def skip_digits: (Integer) -> Integer
    private def parse_integer: (Integer, Integer) -> Integer
    private def parse_float: (Integer, Integer) -> Float
  end
end

class Object
  def to_json: (?untyped state) -> String
end
